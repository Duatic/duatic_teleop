<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>duatic_teleop_ik</name>
  <version>1.0.0</version>
  <description>
    High-performance, JIT-compiled inverse kinematics solver using PyRoki and JAX.
    Subscribes to Cartesian PoseStamped commands and streams smooth JointTrajectory messages.
  </description>
  <author email="tschwarzer@duatic.com">Timo Schwarzer</author>
  <maintainer email="tschwarzer@duatic.com">Timo Schwarzer</maintainer>
  <license>BSD 3-Clause</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>interactive_markers</depend>
  <depend>duatic_kinematics</depend>

  <exec_depend>python3-numpy</exec_depend>
  <!-- dxtr_mock_pyroki_demo.launch.py: standalone local test rig, no hardware -->
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>duatic_control</exec_depend>
  <exec_depend>duatic_dxtr_bringup</exec_depend>
  <exec_depend>duatic_dxtr_example_description</exec_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
