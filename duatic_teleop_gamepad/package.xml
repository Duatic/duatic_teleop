<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>duatic_teleop_gamepad</name>
  <version>1.0.0</version>
  <description>
    Gamepad-based teleoperation interface for Duatic robots.
    Maps gamepad axes and buttons to robot control commands.
  </description>
  <author email="tschwarzer@duatic.com">Timo Schwarzer</author>
  <maintainer email="tschwarzer@duatic.com">Timo Schwarzer</maintainer>
  <license>BSD 3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>controller_manager_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rcpputils</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>trajectory_msgs</depend>

  <exec_depend>joy</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
